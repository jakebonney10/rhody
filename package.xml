<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rhody</name>
  <version>0.0.0</version>
  <description>ROS2 package for ROV Rhody</description>
  <maintainer email="jakebonney10@uri.edu">Jake Bonney</maintainer>
  <license>Apache 2.0</license>

  <!-- Build System -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rs_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rclcpp_components</depend>
  <depend>cv_bridge</depend>

  <!-- Runtime Dependencies -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>voyis_discovery_driver</exec_depend>

  <!-- Isaac ROS: SLAM and dense reconstruction from the Voyis stereo pair.
       Note nvblox_ros rather than the isaac_ros_nvblox metapackage. The
       metapackage pulls nvblox_examples_bringup, whose ESS and segmentation
       demos need TensorRT (libnvinfer10), which is not available from the
       configured apt sources. -->
  <exec_depend>isaac_ros_visual_slam</exec_depend>
  <exec_depend>isaac_ros_stereo_image_proc</exec_depend>
  <exec_depend>isaac_ros_image_proc</exec_depend>
  <exec_depend>nvblox_ros</exec_depend>
  <exec_depend>nvblox_rviz_plugin</exec_depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
